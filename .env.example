# ==============================================================================
# Sales Lead Machine - Environment Configuration Template (.env.example)
# Copy this file to .env and configure real credentials for your local environment.
# Never commit the .env file to version control or distributable packages.
# ==============================================================================

# Cryptographic HMAC-SHA256 Secret Key (Must be at least 32 characters with high entropy)
ADMIN_JWT_SECRET=your-secure-random-32-plus-character-secret-key-here

# PostgreSQL Database Configuration
PGDATABASE=salesleadmachine
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=your_db_username
PGPASSWORD=your_db_password

# Application Server Port (Defaults to 8080 or 8000)
PORT=8080

# Optional: Test Credentials for QA Test Harness
TEST_ADMIN_EMAIL=admin@salesleadmachine.co.uk
TEST_ADMIN_PASSWORD=your_test_admin_password
TEST_USER_EMAIL=regular_user@salesleadmachine.co.uk
TEST_USER_PASSWORD=your_test_user_password
